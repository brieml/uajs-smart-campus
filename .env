# Variables de entorno - UAJS Smart Campus (Frontend)
VITE_APP_NAME=UAJS Smart Campus
# Gateway (único punto de entrada al backend). En local: api-gateway :3000
# Rutas públicas: /api/v1/auth, /api/v1/universidad, /api/v1/catalogos (-> /catalog), /api/v1/archivos (-> /storage)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_API=false
